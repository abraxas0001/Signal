# Copy to .env for local development, or set these in
# Netlify → Site configuration → Environment variables.
#
# The app runs with NONE of these set — it will fetch posts and show everything
# it can read, then tell you the analysis step needs a key. Each key you add
# lights up more of the report.

# ─────────────────────────────────────────────────────────────────────────────
# THE MODEL — set ONE of these to turn on interpretation
# ─────────────────────────────────────────────────────────────────────────────
#
# With none of them set, the app runs in data-only mode: it fetches the post and
# reports every figure the platform publishes. That is a complete result, not a
# failure. What needs a model is the reading of the post — sentiment, tone,
# emotion, summary, intent, translation, topics, named people, grievance type,
# severity, risk, recommended action and talking points. That is most of the
# source spreadsheet's columns, and there is no keyless substitute for it.
#
# The first key found below is the one used, in this order.
#
# BEFORE YOU CHOOSE: this app sends post text to whichever provider you pick.
# That text is often a named allegation against a named official. A provider
# that trains on its inputs is therefore a real decision, not a preference.

# Anthropic — the best quality on Telugu and the default this app was built for.
# Does not train on API inputs. Paid: roughly ₹4.50 per post on Opus, ₹1 on
# Haiku (set LLM_MODEL=claude-haiku-4-5).  https://console.anthropic.com
ANTHROPIC_API_KEY=

# Groq — FREE, no credit card, and the best free option for this product:
# its services agreement bars training on your inputs, and inference data is
# not retained by default. Limits are roughly 30 requests/minute and
# 1,000/day, which is far above what one office will use.
# Quality on Telugu is noticeably below Claude — expect blunter summaries and
# weaker translation.  https://console.groq.com/keys
GROQ_API_KEY=

# Cerebras — FREE, no credit card, ~1M tokens/day. Fast. Check its current
# terms on data use before sending real grievances through it.
# https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Google Gemini — FREE tier, no credit card, ~1,500 requests/day, and good
# Telugu for a free model.
# ⚠️  Google states FREE-TIER inputs and outputs may be used to improve its
# models. Paid keys are excluded. Do not use a free Gemini key for posts naming
# real people unless that is an accepted risk.  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anything else that speaks the OpenAI chat-completions API — OpenRouter,
# Together, a self-hosted vLLM. Set the base URL and model to match.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_LABEL=
# Overrides the default model for WHICHEVER provider above is active.
LLM_MODEL=
# Ceiling on generated tokens. Groq counts this against its tokens-per-minute
# allowance BEFORE generating, so an over-large value is refused outright.
LLM_MAX_TOKENS=

# With several keys set, the first one in the list above wins. Set this to pick
# deliberately instead: anthropic | groq | cerebras | gemini | llm
LLM_PROVIDER=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — improves accuracy
# ─────────────────────────────────────────────────────────────────────────────

# YouTube Data API v3. Free: 10,000 units/day, and one call covers up to 50
# videos, so you will not hit the ceiling.
#
# What it buys: exact like and comment counts on POPULAR videos. Without it we
# read the watch page, which is exact for views but abbreviates large counts
# ("19m" rather than 19,332,841). Small videos are exact either way.
# Get one at https://console.cloud.google.com → enable "YouTube Data API v3".
YOUTUBE_API_KEY=

# Meta app access token, formatted "{APP_ID}|{APP_SECRET}".
#
# Honestly: this buys very little. Facebook's oEmbed returns NO engagement
# counts even with a valid token — the reactions/comments/shares in this app
# come from reading the page, not from the API. Only add this if you already
# have a Meta app.
META_APP_TOKEN=

# Meta Graph API page access token, for a Facebook Page/Instagram Business
# account your office actually administers — real comments, exact share
# counts and reel plays, none of which the public path below can reach.
# A page token authorises exactly one page; it cannot read a rival's page.
# Get one via Meta's Graph API Explorer (developers.facebook.com/tools/explorer),
# request page_read_engagement + read_insights, then exchange it for a
# long-lived token.
# ── Facebook and Instagram: the comments under YOUR OWN posts ───────────────
#
# This is the single highest-value thing to add for an Indian office, and the
# only route to it. Facebook and Instagram publish NOTHING about an account to a
# server without a token — not posts, not comments, at any price. No key from
# Groq, Google or anywhere else changes that.
#
# You must be an admin of the Page. Your own page needs NO app review; review is
# only required to read pages you do not administer.
#
#   1. developers.facebook.com -> create an app -> add "Facebook Login"
#   2. Graph API Explorer -> your app -> "Get Page Access Token" -> pick the page
#   3. Tick pages_read_engagement (the comments) and pages_show_list
#   4. Exchange for a LONG-LIVED token — the one Explorer gives you dies in about
#      an hour: developers.facebook.com/tools/debug/accesstoken
#   5. Paste it below and redeploy
#
# Settings -> "What this desk can read" inspects whatever you set and names the
# exact problem: a User token instead of a Page token, a missing permission, the
# wrong page, or an expiry date. It never prints the token itself.
META_PAGE_TOKEN=

# The Instagram Business/Creator account linked to that same Facebook Page,
# if any. Without this, Instagram still shows a follower count publicly but
# no posts; with it, the Graph API returns real media and comments.
META_IG_USER_ID=

# ─────────────────────────────────────────────────────────────────────────────
# CONNECTING THE OFFICE'S OWN ACCOUNTS — YouTube, LinkedIn, X
# ─────────────────────────────────────────────────────────────────────────────
#
# Extends the Meta pattern above to three more platforms, via OAuth instead
# of a manually pasted token: the office signs in once from Settings, and its
# OWN posts/comments read richly from then on — every other account keeps
# using the public-only path. See README's "Scraping and terms of service"
# for the boundary this respects.
#
# With none of these set, Settings simply shows nothing connectable — the app
# keeps working exactly as it does today.

# Required to use the Settings screen at all. A shared secret, not a login:
# whoever holds it can trigger/view/disconnect a platform connection (but
# cannot complete one — that still needs the office's real Google/LinkedIn/X
# login). Generate one with `openssl rand -base64 24` or similar.
SETTINGS_ACCESS_KEY=

# Encrypts connected-account tokens before they are written to Netlify Blobs.
# Must decode to exactly 32 bytes. Generate with:
#   openssl rand -base64 32
CONNECTIONS_ENCRYPTION_KEY=

# Signs the OAuth state parameter (CSRF protection on the connect flow). Any
# long random string; generate the same way as SETTINGS_ACCESS_KEY.
OAUTH_STATE_SECRET=

# YouTube — Google Cloud Console → APIs & Services → Credentials → OAuth
# client ID (type: Web application). Add
# "<your-site>/api/oauth/youtube/callback" as an authorised redirect URI.
# Keep the consent screen in "Testing" mode to skip Google's manual review.
# Free: draws against the same 10,000 units/day quota as YOUTUBE_API_KEY
# above. What it buys: exact like/view/comment counts and real comment
# bodies on the office's own uploads — the public path below has no like
# count at all.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# LinkedIn — developer.linkedin.com → create an app → add
# "<your-site>/api/oauth/linkedin/callback" as a redirect URL.
#
# Honestly: this buys identity confirmation only ("this is the office's
# LinkedIn account") to start. Reading a Company Page's actual posts needs
# LinkedIn's separate, manually reviewed Community Management API — apply
# for it if you want more than identity, then widen LINKEDIN_OAUTH_SCOPE
# once approved. Nothing else needs to change when that happens.
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
# Default is "openid profile email" (identity only). Widen only once
# LinkedIn has approved the office's app for Company Page access.
LINKEDIN_OAUTH_SCOPE=

# X / Twitter — developer.x.com → create an app (confidential client, OAuth
# 2.0 enabled) → add "<your-site>/api/oauth/x/callback" as a callback URL.
#
# Honestly: this buys identity confirmation only. X's free API tier has NO
# read access at all, even for your own account — reading tweet metrics
# needs a paid tier (historically $200+/month for the cheapest one that
# reads). Decide that separately; nothing here assumes you've bought it.
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# BEHAVIOUR
# ─────────────────────────────────────────────────────────────────────────────

# Facebook, Instagram and Threads serve engagement data to crawler user-agents
# but not to ordinary browsers, so those adapters present one. This works, and
# it is also the single most legally exposed thing in this codebase — see the
# "Scraping and terms of service" section of README.md before deploying
# commercially.
#
# Set to "false" to switch it off. With it off, no adapter claims an identity
# we do not have — not even facebookexternalhit. The app keeps working: it
# still returns the caption, author, date and thumbnail, and asks the user to
# type the counts in. Every other platform is unaffected, because none of them
# needs a crawler identity.
ALLOW_CRAWLER_UA=true

# ── Pages you do NOT administer (rivals, opponents) ─────────────────────────
#
# Meta authorises a token for exactly one page: yours. There is no key, free or
# paid, that reads somebody else's — that is Meta's boundary, not this app's.
#
# The legitimate route is a provider that already holds the data and licenses
# access: Apify, Bright Data, Phyllo. Roughly $30-100/month.
#
# This app is deliberately vendor-neutral. Point it at any endpoint speaking
# this contract and it works:
#
#   POST $SOCIAL_PROVIDER_URL
#   Authorization: Bearer $SOCIAL_PROVIDER_KEY
#   { "kind": "comments", "platform": "Facebook", "url": "...", "limit": 100 }
#     -> { "comments": [ { "text", "author", "likes", "publishedAt" } ] }
#   { "kind": "posts", "platform": "Facebook", "handle": "SomePage" }
#     -> { "posts": [ { "url", "id", "title", "publishedAt", "likes", "comments" } ] }
#
# Anything a provider supplies is labelled as third-party data wherever it is
# shown, and is never blended with what a platform itself told us.
SOCIAL_PROVIDER_URL=
SOCIAL_PROVIDER_KEY=
