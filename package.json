    "@vitejs/plugin-react": "^6.0.5",
    "netlify-cli": "^27.1.2",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
