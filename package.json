{
  "name": "signal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Signal — paste any public social media post link and get a full intelligence readout: what it says, what it means, how it landed, and what to do about it.",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:extract": "tsx scripts/test-extract.ts",
    "test:news": "tsx scripts/test-news.ts",
    "test:sheet": "tsx scripts/test-sheet.ts",
    "test:model": "tsx scripts/test-model.ts",
    "compare:models": "tsx scripts/compare-models.ts",
    "test:endpoint": "tsx scripts/test-endpoint.ts",
    "test:schema": "tsx scripts/test-schema.ts",
    "test:contrast": "tsx scripts/test-contrast.ts",
    "test:handles": "tsx scripts/test-handles.ts",
    "test:comments": "tsx scripts/test-comments.ts",
    "test:export": "tsx scripts/test-export.ts",
    "test:typography": "tsx scripts/test-typography.ts",
    "test:ssrf": "tsx scripts/test-ssrf.ts",
    "test": "npm run typecheck && npm run test:ssrf && npm run test:schema && npm run test:scoping && npm run test:places && npm run test:autoconfig && npm run test:matching && npm run test:contrast && npm run test:typography && npm run test:handles && npm run test:sync && npm run test:comments && npm run test:export && npm run test:extract && npm run test:news",
    "test:scoping": "tsx scripts/test-scoping.ts",
    "test:places": "tsx scripts/test-places.ts",
    "test:autoconfig": "tsx scripts/test-autoconfig.ts",
    "test:matching": "tsx scripts/test-matching.ts",
    "test:sync": "tsx scripts/test-sync.ts",
    "scraper": "tsx --env-file-if-exists=.env scraper/server.ts",
    "scraper:login": "tsx --env-file-if-exists=.env scraper/login.ts",
    "scraper:test": "tsx --env-file-if-exists=.env scraper/test.ts",
    "scraper:probe": "tsx --env-file-if-exists=.env scraper/probe.ts",
    "scraper:session": "tsx --env-file-if-exists=.env scraper/session-status.ts",
    "test:counts": "tsx scripts/test-parse-count.ts",
    "scraper:demo": "tsx --env-file-if-exists=.env scraper/build-demo.ts",
    "scraper:media": "tsx --env-file-if-exists=.env scraper/fetch-avatars.ts",
    "scraper:shrink": "tsx scraper/shrink-media.ts",
    "scraper:opinions": "tsx --env-file-if-exists=.env scraper/read-opinions.ts"
  },
  "dependencies": {
